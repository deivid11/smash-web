# Copy to .env (ignored by Git). `npm run serve` loads it from the repository root;
# variables already set in the environment win over this file.

# Who supplies the game discs.
#   server  (default) this host verifies its own ISO and streams the allowlisted assets;
#           players need no disc. This is the historical behaviour.
#   client  every player must select their own ISO in the browser. This host opens no
#           disc and serves no game asset (every /api/assets name is a 404).
SMASH_DISC_SOURCE=server

# --- SMASH_DISC_SOURCE=server -------------------------------------------------------
# Original USA v1.02 ISO. Unset = the path recorded by `npm run disc:import`.
#MELEE_ISO=private/disc/melee-v102.iso
# ACE 2.0 extension ISO. Unset = original roster only (no ACE fighters).
#MELEE_ACE_ISO=private/disc/ace-2.0.iso

# --- SMASH_DISC_SOURCE=client -------------------------------------------------------
# The original ISO is always required from the player. ACE 2.0 policy:
#   optional  (default) players may add the ACE ISO, or skip it and play the original roster
#   required  players must supply both ISOs
#   off       the ACE slot is hidden; original roster only
SMASH_CLIENT_ACE=optional

# --- Common -------------------------------------------------------------------------
#SMASH_HOST=0.0.0.0
#SMASH_PORT=5273
#SMASH_ALLOWED_HOSTS=smash.example.org
#SMASH_DB_PATH=private/accounts.sqlite
# Pseudonymous visit/usage statistics (SQLite, no dashboard; players can opt out in Options).
# `off` disables them. Default: private/analytics.sqlite
#SMASH_ANALYTICS_DB=private/analytics.sqlite
