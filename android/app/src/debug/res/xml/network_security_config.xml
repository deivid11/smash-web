<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the emulator's host alias so the
     self-update flow can be exercised against a local test channel
     (SMASH_UPDATE_URL). Everything else keeps the platform https default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
